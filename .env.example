# Copy this file to .env.local and paste your NEW Neon connection string.
#
#   cp .env.example .env.local
#
# Get it from the Neon dashboard → Connect to your database → Connection string,
# with "Connection pooling" ON (the -pooler host). Reset the password first if the
# old one was ever pasted into a chat, a screenshot, or a commit.
#
# .env.local is gitignored. Never put this value in any file under public/,
# never send it to the browser, never paste it into a chat.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
