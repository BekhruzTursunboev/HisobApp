{
  "name": "hisob",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hisob - a spend tracker for international students. Log what you spend, split bills, add a budget only if you want one.",
  "scripts": {
    "build": "node scripts/build.js",
    "icons": "node scripts/icons.js",
    "dev": "node scripts/build.js && node scripts/serve.js",
    "db:push": "node scripts/migrate.js",
    "db:check": "node scripts/check.js",
    "test:api": "node scripts/e2e.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  },
  "devDependencies": {
    "dotenv": "^17.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
